#!/bin/bash
# yukitube — YouTube with uBlock Origin and YouTube NonStop, played from the
# YukiTube remote.
#
#   yukitube                 open the remote (YouTube runs hidden behind it)
#   yukitube <link>          play a YouTube link
#   yukitube <words...>      search YouTube in the remote
#   yukitube --remote        open only the remote, for other browsers
#
# YouTube runs in a headless Firefox on a profile of its own, so its sign-in,
# history, and add-ons never mix with the user's main Firefox; the remote
# starts it, and shows its window only when asked (or to sign in to Google).
# YUKITUBE_REMOTE=0 opens the Firefox window alone, as before 0.4.0.
set -euo pipefail

self=$(readlink -f "$0")
here=$(dirname "$self")
if [[ -n ${YUKITUBE_SHARE:-} ]]; then
  share=$YUKITUBE_SHARE
elif [[ -d $here/../share/yukitube ]]; then
  share=$here/../share/yukitube
else
  share=$here/../share
fi
profile=${YUKITUBE_PROFILE:-${XDG_DATA_HOME:-$HOME/.local/share}/yukitube/profile}

fail() {
  echo "yukitube: $*" >&2
  command -v notify-send >/dev/null && notify-send -a YukiTube "YukiTube" "$*" || true
  exit 1
}

# The YukiTube remote: a built binary (release archive), the Python sources
# (Arch package), or the checkout.
remote=()
if [[ -x $share/remote/yukitube-remote ]]; then
  remote=("$share/remote/yukitube-remote")
elif [[ -f $share/remote/yukitube_remote.py ]]; then
  remote=(python3 "$share/remote/yukitube_remote.py")
elif [[ -f $here/../remote/app/yukitube_remote.py ]]; then
  remote=(python3 "$here/../remote/app/yukitube_remote.py")
fi

remote_running() {
  curl -fs --max-time 1 http://127.0.0.1:8975/nt/ping 2>/dev/null | grep -q '"yukitube-remote"'
}

# Started detached. A remote that already runs takes the arguments from the
# new one (a link to play, a search) and comes to the front.
start_remote() {
  ((${#remote[@]})) || return 1
  local log=${XDG_STATE_HOME:-$HOME/.local/state}/yukitube/remote.log
  mkdir -p "$(dirname "$log")"
  remote_running && { "${remote[@]}" --quiet-if-running "$@" >>"$log" 2>&1 </dev/null; return 0; }
  setsid -f "${remote[@]}" --quiet-if-running "$@" >"$log" 2>&1 </dev/null
}

if [[ ${1:-} == --remote ]]; then
  ((${#remote[@]})) || fail "The YukiTube remote is not installed."
  start_remote || true
  exit 0
fi

command -v firefox >/dev/null || fail "Firefox is not installed. Install it with: sudo pacman -S firefox"

mkdir -p "$profile/extensions" "$profile/chrome"

# Add-ons are copied in once; after that Firefox keeps them updated itself.
# The package ships verified copies; a checkout downloads and verifies them.
while IFS=$'\t' read -r name guid url sha256; do
  [[ -z $name || $name == \#* ]] && continue
  target="$profile/extensions/$guid.xpi"
  [[ -f $target ]] && continue
  if [[ -f $share/addons/$guid.xpi ]]; then
    cp "$share/addons/$guid.xpi" "$target"
  else
    tmp=$(mktemp "$profile/extensions/.download.XXXXXX")
    curl -fsSL --max-time 60 -o "$tmp" "$url" || { rm -f "$tmp"; fail "Could not download $name."; }
    echo "$sha256  $tmp" | sha256sum --quiet -c - || { rm -f "$tmp"; fail "$name did not match its checksum."; }
    mv "$tmp" "$target"
  fi
done <"$share/addons.tsv"

cp "$share/user.js" "$profile/user.js"

# The retrowave look: the window (userChrome) and YouTube itself (userContent).
cp "$share/userChrome.css" "$share/userContent.css" "$profile/chrome/"


# A YouTube link, the remote's own address (the bridge userscript it
# offers), or Google's sign-in pages (the remote's account button) open as
# is; anything else is a search.
url=
if (($#)); then
  input="$*"
  if [[ $input =~ ^http://127\.0\.0\.1:8975/ || $input =~ ^https://accounts\.google\.com/ ]]; then
    url=$input
  elif [[ $input =~ ^(https?://)?([a-z0-9-]+\.)*(youtube\.com|youtu\.be)(/|$) ]]; then
    [[ $input == http* ]] && url=$input || url="https://$input"
  else
    url="https://www.youtube.com/results?search_query=$(jq -rn --arg q "$input" '$q|@uri')"
  fi
fi

# The remote runs YouTube in this Firefox, hidden. On the first launch it
# first puts the bridge userscript into Violentmonkey, out of sight.
if [[ ${YUKITUBE_REMOTE:-1} != 0 ]] && ((${#remote[@]})); then
  start_remote --firefox "$(command -v firefox)" --profile "$profile" ${url:+"$url"}
  exit 0
fi

# --name sets the Wayland app id, so Hyprland and the launcher match the
# window to yukitube.desktop. A second launch reaches the running window.
exec firefox --name yukitube --class yukitube --profile "$profile" ${YUKITUBE_FIREFOX_ARGS:-} ${url:+"$url"}
