[Desktop Entry]
Type=Application
Name=YukiTube
Name[ro]=YukiTube
Comment=A retrowave YouTube player, without ads
Comment[ro]=Player YouTube retrowave, fără reclame
Exec=yukitube %u
Icon=yukitube
Terminal=false
Categories=AudioVideo;Video;
Keywords=youtube;video;music;player;remote;telecomanda;
StartupWMClass=yukitube-remote
Actions=remote;

[Desktop Action remote]
Name=Remote only
Name[ro]=Doar telecomanda (pentru alt browser)
Exec=yukitube --remote
